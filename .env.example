# This file shows the settings needed for local development.
# Copy it to .env and fill database credentials and administrator details.
# Set JAVA_HOME to your JDK folder if needed, then run npm run dev.
DATABASE_URL=jdbc:postgresql://YOUR_NEON_HOST:5432/neondb?sslmode=require&channelBinding=require
DATABASE_USER=YOUR_DATABASE_USER
DATABASE_PASSWORD=YOUR_DATABASE_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_DATA=true
APP_CURRENCY=INR
COOKIE_SECURE=false
PORT=8080
FRONTEND_PORT=5173
