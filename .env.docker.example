# This file shows the settings for the Docker setup.
# Copy it to .env.docker and choose database and administrator passwords.
# Run docker compose --env-file .env.docker up --build from the root.
DATABASE_PASSWORD=replace-with-a-strong-database-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_DATA=true
APP_CURRENCY=INR
COOKIE_SECURE=false
WEB_PORT=8088
